# =====================================================================
#  ipa-site 配置文件
#  使用：cp .env.example .env，按需修改后运行 docker compose up -d
#  改完 .env 必须用 `docker compose up -d` 重建容器才生效（restart 不会重新读取）
#  开关类配置只认 1（开）和 0（关）
# =====================================================================


# ---------------------------------------------------------------------
# 1. 网站访问密码
# ---------------------------------------------------------------------

# 访问网站时浏览器会弹出登录框：用户名随便填，密码填这里的值。
# 网站能用你的 Apple ID 下载，开放到局域网/外网时一定要设置。
# 生成随机密码：openssl rand -base64 24
# 密码里有 $ # 空格等字符时，用单引号括起来：IPA_PASSWORD='a$b#c'
IPA_PASSWORD=

# 只在可信内网使用、确定不要密码时才设为 1（同时把上面的 IPA_PASSWORD 留空）。
# 不设密码又没打开这个开关，网站会拒绝启动，防止忘记设密码就对外开放。
IPA_ALLOW_NO_PASSWORD=0


# ---------------------------------------------------------------------
# 2. 下载
# ---------------------------------------------------------------------

# 商店地区代码，用于补全图标、开发者、大小等信息，以及查询最新版本号。
# 和你的 Apple ID 所在地区一致：cn 中国大陆、us 美国、hk 香港、jp 日本……
IPA_COUNTRY=cn

# 同时进行的下载任务数（ipatool 每个任务只用一条连接，多开几个总速度更快）。
IPA_CONCURRENCY=3


# ---------------------------------------------------------------------
# 3. 上传到 Alist（可选，ALIST_URL 留空则不启用）
# ---------------------------------------------------------------------

# Alist 地址。容器里访问不到 localhost，要填服务器的局域网 IP，例如 http://192.168.1.10:5244
ALIST_URL=

# Alist 账号密码（需要有往下面目录写入文件的权限）
ALIST_USERNAME=
ALIST_PASSWORD=

# 上传到 Alist 里的哪个目录，例如 /阿里云盘/ipa
ALIST_DIR=/

# 下载完成后是否自动上传：1 = 自动上传，0 = 只在点「传到 Alist」时上传
ALIST_AUTO_UPLOAD=0


# ---------------------------------------------------------------------
# 4. 直接安装（可选）
# ---------------------------------------------------------------------

# iPhone 一键安装（系统安装 itms-services）需要一个手机能访问、证书可信的 https 地址，
# 一般用 Lucky / Caddy / Nginx 反向代理到 http://127.0.0.1:8686 并申请证书。
# 例：IPA_PUBLIC_URL=https://ipa.example.com:8443
# 留空时「系统安装」不可用；TrollStore 安装不受影响。
IPA_PUBLIC_URL=


# ---------------------------------------------------------------------
# 5. 网络与存储
# ---------------------------------------------------------------------

# 容器的网卡 MAC 地址（必填）。ipatool 用它生成「设备标识」，Apple 靠它认出是同一台设备，
# 重建容器也不用重新登录 Apple ID。每个部署用自己的一个，定下来就不要改（改了要重新登录），
# 也不要和局域网里其他设备重复。生成一个随机的（02 开头表示本地自定义地址）：
#   printf '02:%02x:%02x:%02x:%02x:%02x\n' $(od -An -N5 -tu1 /dev/urandom)
# 从旧版本升级：填旧 docker-compose.yml 里原来写的 mac_address，就不用重新登录。
IPA_MAC_ADDRESS=

# 网站端口绑定的地址：IPv4 用 IPA_BIND，IPv6 用 IPA_BIND6。
# 默认所有地址都能访问；只想让本机的反向代理访问时改成 127.0.0.1 和 [::1]。
IPA_BIND=0.0.0.0
IPA_BIND6=[::]

# 数据（Apple ID 登录状态、钥匙串口令、下载的 IPA）存放位置：
#   留空      = Docker 卷 ipa-data
#   填目录    = 直接存到该目录，例如 ./data（先执行 mkdir -p data && chown 1000:1000 data）
IPA_DATA=


# ---------------------------------------------------------------------
# 6. 可选：Caddy 自动 HTTPS（docker compose --profile https up -d 时才用到）
# ---------------------------------------------------------------------

# 解析到这台服务器、并且 80/443 端口能从公网访问的域名
DOMAIN=
